\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Harmful-refusal rate against the weight statistic for five checkpoints built or measured under held-fixed conditions. Root B, a depth-weighted Gaussian abliteration with the removed direction held fixed at root A's, un-censors from 0.950 to 0.270 while reading its parent's $W05$ to four decimals ($\cos (v_1,r)=0.0199$): a false negative. Root C, a uniform edit along the AUROC-argmax direction, fires the full signature at $-4.587$ while refusing at its parent's rate: a false positive. Intervals are 95\% Wilson on the frozen 40-item harmful core.}}{18}{figure.6}\protected@file@percent }
\newlabel{fig:fig6}{{6}{18}{Harmful-refusal rate against the weight statistic for five checkpoints built or measured under held-fixed conditions. Root B, a depth-weighted Gaussian abliteration with the removed direction held fixed at root A's, un-censors from 0.950 to 0.270 while reading its parent's $W05$ to four decimals ($\cos (v_1,r)=0.0199$): a false negative. Root C, a uniform edit along the AUROC-argmax direction, fires the full signature at $-4.587$ while refusing at its parent's rate: a false positive. Intervals are 95\% Wilson on the frozen 40-item harmful core}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Built-to-order checkpoints exhibiting dissociation in both directions between the weight verdict and harmful-refusal behaviour.}}{18}{table.4}\protected@file@percent }
\newlabel{tab:dissoc}{{4}{18}{Built-to-order checkpoints exhibiting dissociation in both directions between the weight verdict and harmful-refusal behaviour}{table.4}{}}
